# Адрес сервера (0.0.0.0 — доступ из сети, для TMS; 127.0.0.1 — только локально)
HOST=0.0.0.0
PORT=18632

# Ключ входящих запросов (обязательно задай при HOST=0.0.0.0!)
# PROXY_API_KEY=change-me

# Креды DeepSeek для headless авто-логина (без окна)
# DS_EMAIL=you@example.com
# DS_PASSWORD=your-password

# Модель по умолчанию (без размышлений), если в запросе не задана/неизвестна
# DEFAULT_MODEL=deepseek-chat

# Формат non-stream ответа: text (голый текст для TMS) | openai (полный JSON)
# RESPONSE_FORMAT=text
